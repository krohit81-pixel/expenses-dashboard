# Public — safe to expose to the browser. See src/lib/env/public.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser. See src/lib/env/server.ts.
# Bypasses Row Level Security. Required for src/lib/supabase/service.ts,
# which is now the ONLY data-access client the app uses (see
# src/lib/owner.ts) — there is no session-based auth anymore.
SUPABASE_SERVICE_ROLE_KEY=

# There is no visible sign-in screen and no session — every request runs
# as this single fixed account (see src/middleware.ts, src/lib/owner.ts).
# This is NOT a login credential; it's just the UUID of a Supabase Auth
# user created once via `npm run bootstrap:owner` (see INSTALL.md). Every
# row in the database belongs to this ID.
APP_OWNER_USER_ID=

# The access gate — a single shared password for the whole app (not
# Supabase Auth). /calendar stays public; every other page requires this
# once per browser. See src/lib/access-gate.ts.
APP_ACCESS_PASSWORD=
# Signs the access-gate cookie. Generate a random string at least 32
# characters long — don't reuse another secret. e.g.: openssl rand -hex 32
APP_SESSION_SECRET=

# Optional, added in v3.4.0 — Ahaana's own gate for her mini app
# (/ahaana/*), signed with the same APP_SESSION_SECRET above but a
# completely different password than APP_ACCESS_PASSWORD, so neither
# password unlocks the other's section. Until this is set, /ahaana
# refuses every request rather than the app failing to boot. See
# src/lib/ahaana-gate.ts.
AHAANA_ACCESS_PASSWORD=

# Optional, added in v3.4.0 Phase 2 — real web push notifications for
# Ahaana's mini app (she has no Telegram). Generate the key pair once:
#   npx web-push generate-vapid-keys
# Never regenerate once real subscriptions exist — the public key is
# baked into each subscription at creation time; a new key pair
# silently breaks every existing one. VAPID_SUBJECT is a contact
# URL/mailto the Web Push spec requires — use a project URL, not a
# personal email, since it's sent to Google/Mozilla/Apple's push
# infrastructure on every send.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional, added in v3.4.12 — Microsoft Graph email-reading proof of
# concept ("Connect School Email" on /ahaana-progress). From a
# Microsoft Entra app registration (Web platform, multi-tenant "any
# organizational directory", Mail.Read + User.Read delegated Graph
# permissions) -- see INSTALL.md for the full walkthrough.
# MICROSOFT_CLIENT_ID/MICROSOFT_CLIENT_SECRET are required for the
# feature to work at all; MICROSOFT_TENANT_ID is rarely needed (unset,
# the OAuth authority defaults to "organizations", correct for a
# school-issued account signing into an app registered in a different
# tenant).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Optional — Intel's auto-generated insight (a short natural-language
# summary of this month's cash flow). The page and its charts work fine
# without either of these; the insight card just shows a "not configured"
# message instead. Set one or the other, not necessarily both — if both
# are set, Anthropic is used. See src/services/IntelService.ts.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional — overrides the default Gemini model (gemini-2.5-flash) used
# when GEMINI_API_KEY is set. Only needed if that default is ever deprecated.
GEMINI_MODEL=

# Optional — password for HDFC's Infinia credit card statement PDF (they
# email these encrypted). Without it, the Imports page still loads, it
# just can't decrypt a protected PDF and says so rather than crashing.
# See src/services/StatementImportService.ts.
HDFC_INFINIA_STATEMENT_PASSWORD=

# Optional — same as above, for a real Tata Neu Plus HDFC Bank Credit
# Card statement (v1.11.0). Reuses the same hdfc-infinia-tata parser
# module as Infinia above (renamed once this second card reconciled
# against it with no code changes needed), but deliberately kept as its
# OWN password variable rather than folding into
# HDFC_INFINIA_STATEMENT_PASSWORD — HDFC's co-branded cards aren't
# guaranteed to share the core Infinia product's password formula, unlike
# the Axis/ICICI cases below where a second real statement confirmed the
# same password scheme.
HDFC_TATA_STATEMENT_PASSWORD=

# Optional — same as above, for Axis's own encrypted statement PDFs.
# Covers both card products the axis-horizon-airtel parser handles
# (Horizon and the Airtel co-branded Mastercard) — one shared variable,
# not a per-product one, since Axis uses the same password scheme for
# both. A separate variable from HDFC/ICICI's since each bank's password
# scheme has no reason to match another's. Added in v1.7.0 as
# AXIS_HORIZON_STATEMENT_PASSWORD, renamed in v1.10.0.
AXIS_STATEMENT_PASSWORD=

# Optional — same as above, for ICICI's own encrypted statement PDFs.
# Covers both card products the icici-amazon-rupay parser handles (Amazon
# Pay and RuPay-variant cards) — confirmed to use the same password
# scheme for both, so one shared variable rather than a per-product one.
ICICI_STATEMENT_PASSWORD=

# Optional — v3.2.0, the first notification channel (calendar-event
# reminders). The token @BotFather gives you after `/newbot` in
# Telegram. Without it, the reminder toggle still saves on an event,
# it just never actually sends — ReminderService no-ops rather than
# the app failing to boot over this. See
# src/lib/notifications/providers/telegram.ts. The per-owner Telegram
# chat ID itself is NOT an env var — that's entered once in the app's
# own Settings page (finance.notification_channels), not here.
TELEGRAM_BOT_TOKEN=
# Optional — authenticates /api/cron/reminders (added once Vercel Cron
# is wired up) so it can't be triggered by anyone who finds the URL.
# Vercel automatically sends this exact value as a bearer token when a
# Cron job invokes the route, as long as this env var is named exactly
# CRON_SECRET — no extra wiring needed on Vercel's side. Generate a
# random string, same as APP_SESSION_SECRET: openssl rand -hex 32
CRON_SECRET=
